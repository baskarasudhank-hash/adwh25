# ==========================================================
#  HOW TO USE THIS FILE (Windows)
#  1. Rename this file to:  .env
#  2. Paste your real API key after ZAI_API_KEY=
#  3. Save the file.  Done!
#
#  Get a free API key:  https://z.ai/model-api  -> API Keys
# ==========================================================

ZAI_API_KEY=your_api_key_here

# AI model. glm-5.3-flash is fast and low cost.
# Other options: glm-5.3  (better quality, costs a little more)
ZAI_MODEL=glm-5.3-flash
